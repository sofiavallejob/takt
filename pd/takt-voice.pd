#N canvas 120 120 620 520 12;
#X obj 30 20 inlet;
#X obj 30 60 unpack f f f f f f;
#X obj 30 110 expr \$f1*pow(2 \, min(\$f2*1.5 \, 50)/1200);
#X obj 30 160 osc~;
#X obj 160 160 * 2;
#X obj 160 200 osc~;
#X obj 160 240 *~ 0.25;
#X obj 30 280 +~;
#X obj 30 320 lop~ 3200;
#X obj 30 370 *~;
#X obj 250 330 vline~;
#X msg 250 290 \$1 4 \, 0 2200 4;
#X obj 250 250 * 0.12;
#X obj 400 250 expr cos((\$f1+1)*0.785398);
#X obj 400 290 expr sin((\$f1+1)*0.785398);
#X obj 30 420 *~ 0;
#X obj 160 420 *~ 0;
#X obj 30 470 outlet~;
#X obj 160 470 outlet~;
#X text 330 20 One string. In: freq midi pan amp late pos;
#X text 330 44 Late trains are detuned \, 1.5 cents a minute \, up to 50;
