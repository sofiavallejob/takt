#N canvas 40 40 900 640 12;
#X declare -path voices;
#X obj 700 600 declare -path voices;
#X text 20 14 TAKT: the trains as OSC \, played here.;
#X text 20 36 1) Start the bridge: node tools/osc-bridge.mjs --port 8080 --to 9000 (or your own ports).;
#X text 20 56 2) In Takt: Advanced > Output \, the bridge port \, Connect. 3) Pick a synth or a preset below.;
#X floatatom 130 90 6 1 65535 0 OSC\ port\ (UDP) takt-port-set takt-port 0;
#X obj 300 88 bng 18 120 50 0 empty takt-blink notes 24 9 0 12 #fcfcfc #000000 #000000;
#X floatatom 420 90 6 0 0 0 trains takt-trains - 0;
#X floatatom 560 90 6 0 0 0 late takt-late - 0;
#X symbolatom 700 90 18 0 0 0 - takt-network - 0;
#X floatatom 130 118 6 0 0 0 level\ dB takt-level - 0;
#X text 20 160 SYNTH;
#X text 260 160 PRESET;
#X obj 20 185 vradio 20 1 0 6 takt-synth takt-synth-set empty 0 -10 0 12 #dfdfdf #000000 #000000 0;
#X text 46 186 Pluck;
#X text 46 206 Ambient pad;
#X text 46 226 Bell;
#X text 46 246 Glass;
#X text 46 266 Mallet;
#X text 46 286 Breath;
#X obj 260 185 vradio 20 1 0 6 takt-preset takt-preset-set empty 0 -10 0 12 #dfdfdf #000000 #000000 0;
#X text 286 186 Clean pluck;
#X text 286 206 Ambient;
#X text 286 226 Echo chamber;
#X text 286 246 Bells in a hall;
#X text 286 266 Dry percussion;
#X text 286 286 Night breath;
#X text 520 160 SOUND \, ECHO \, ROOM;
#X obj 520 190 hsl 180 16 0 1 0 0 takt-vol takt-vol-set Volume -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 190 7 0 0 0 - takt-vol - 0;
#X obj 520 224 hsl 180 16 0.2 4 0 0 takt-att takt-att-set Attack -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 224 7 0 0 0 - takt-att - 0;
#X obj 520 258 hsl 180 16 0.2 4 0 0 takt-rel takt-rel-set Release -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 258 7 0 0 0 - takt-rel - 0;
#X obj 520 292 hsl 180 16 300 9000 1 0 takt-bright takt-bright-set Brightness -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 292 7 0 0 0 - takt-bright - 0;
#X obj 520 326 hsl 180 16 0 8 0 0 takt-detune takt-detune-set Late\ detune -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 326 7 0 0 0 - takt-detune - 0;
#X obj 520 360 hsl 180 16 50 1500 0 0 takt-dtime takt-dtime-set Delay\ time -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 360 7 0 0 0 - takt-dtime - 0;
#X obj 520 394 hsl 180 16 0 0.85 0 0 takt-dfb takt-dfb-set Delay\ feedback -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 394 7 0 0 0 - takt-dfb - 0;
#X obj 520 428 hsl 180 16 0 0.8 0 0 takt-dmix takt-dmix-set Delay\ mix -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 428 7 0 0 0 - takt-dmix - 0;
#X obj 520 462 hsl 180 16 0 1 0 0 takt-rmix takt-rmix-set Reverb\ mix -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 462 7 0 0 0 - takt-rmix - 0;
#X obj 520 496 hsl 180 16 0 98 0 0 takt-rsize takt-rsize-set Reverb\ size -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 496 7 0 0 0 - takt-rsize - 0;
#X obj 520 530 hsl 180 16 0 90 0 0 takt-rdamp takt-rdamp-set Reverb\ damping -2 -9 0 12 #dfdfdf #000000 #000000 0 1;
#X floatatom 710 530 7 0 0 0 - takt-rdamp - 0;
#X text 20 330 Attack and Release scale each synth's own envelope (1 = as designed).;
#X text 20 350 Late detune: cents out of tune for every minute a train is late.;
#X text 20 370 Sends from the bridge: /takt/pluck /takt/click /takt/hour /takt/state.;
#X text 20 390 Your own synth: any abstraction with one inlet (freq midi pan amp late pos);
#X text 20 410 and two outlet~s \, in voices/. See README \, "OSC out".;
#N canvas 60 60 1100 700 engine 0;
#X text 20 10 OSC from the bridge (UDP) -> the selected synth -> delay -> reverb -> out;
#X obj 20 40 netreceive -u -b 9000;
#X msg 200 10 listen \$1;
