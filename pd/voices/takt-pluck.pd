#N canvas 40 40 640 520 12;
#X obj 20 20 inlet;
#X obj 20 50 unpack f f f f f f;
#X obj 20 90 expr \$f1*pow(2 \, min(\$f2*\$f3 \, 60)/1200);
#X obj 260 60 r takt-detune;
#X obj 260 140 * 0.12;
#X obj 260 170 pack 0 4 2200;
#X obj 380 100 r takt-att;
#X obj 380 130 * 4;
#X obj 480 100 r takt-rel;
#X obj 480 130 * 2200;
#X msg 260 200 \$1 \$2 \, 0 \$3 \$2;
#X obj 260 230 vline~;
#X obj 20 130 osc~;
#X obj 120 130 * 2;
#X obj 120 160 osc~;
#X obj 120 190 *~ 0.25;
#X obj 20 260 +~;
#X obj 20 330 *~;
#X obj 20 360 lop~ 3200;
#X obj 120 330 r takt-bright;
#X obj 380 300 expr cos((\$f1+1)*0.785398);
#X obj 380 330 expr sin((\$f1+1)*0.785398);
#X obj 20 400 *~ 0;
#X obj 160 400 *~ 0;
#X obj 20 450 outlet~;
#X obj 160 450 outlet~;
#X text 380 20 pluck: a fundamental and a soft octave \, plucked;
